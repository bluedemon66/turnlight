; Godot 4.7 .NET / 2D.
config_version=5

[application]
config/name="一线光束"
run/main_scene="res://scenes/LevelsDemo.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=580
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]
project/assembly_name="OneBeam"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.12, 0.115, 1)
